# List the targets in the Justfile
_default:
    @just --list --list-prefix '👉  '

# Install project dependencies into a virtual environment
install:
    uv venv

# Build the Python package
build:
    uv build

# Build the docs with sphinx
docs-build:
    uv run --group docs \
        sphinx-build \
            --nitpicky \
            --show-traceback \
            --fail-on-warning \
            --builder html \
            docs docs/_build/html

# Run the {{package_name}} CLI
run:
    uv run {{package_name}}

# Run tests (include an optional test path to select tests to run.)
test test='':
    uv run pytest {% raw %}{{test}}{% endraw %}

# Lint the code
check:
    uv run ruff check
    uv run interrogate

# Format the code
fix:
    uv run ruff format
